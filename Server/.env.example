# PostgreSQL connection string (Prisma)
DATABASE_URL=postgresql://postgres:password@localhost:5432/doodleblue

# Port the backend listens on (the client's /api rewrite targets :5000)
PORT=5000

# Frontend origin(s) allowed to call this API (comma-separated)
CLIENT_URL=http://localhost:3000

# Session cookie
SESSION_COOKIE_NAME=app.sid
SESSION_SAME_SITE=lax
NODE_ENV=development

# Seed — initial super admin account (pnpm seed)
SUPER_ADMIN_NAME=System Administrator
SUPER_ADMIN_EMAIL=superadmin@example.com
SUPER_ADMIN_PASSWORD=12345678910

# Mail (optional — account invite emails via Resend)
# RESEND_API_KEY=
# MAIL_FROM=DoodleBlue <onboarding@resend.dev>

# Number Parking — optional overrides (defaults shown). Stripe Checkout
# requires ≥ ~₹50, so values below that will fail at payment.
# PARKING_PRICE_15_INR=59
# PARKING_PRICE_30_INR=99
# PARKING_MAX_EXTENSIONS=2
# PARKING_PROCESSING_FEE_INR=0

# Carrier/telecom eligibility integration for Number Parking (optional —
# when unset, eligibility is checked locally and marked simulated)
# ZYLO_CARRIER_API_URL=
# ZYLO_CARRIER_API_KEY=
