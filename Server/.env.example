# PostgreSQL connection string (Prisma)
DATABASE_URL=postgresql://postgres:password@localhost:5432/doodleblue

# Port the backend listens on (the client's /api rewrite targets :5000)
PORT=5000

# Frontend origin(s) allowed to call this API (comma-separated)
CLIENT_URL=http://localhost:3000

# Session cookie
SESSION_COOKIE_NAME=app.sid
SESSION_SAME_SITE=lax
NODE_ENV=development

# Seed — initial super admin account (pnpm seed)
SUPER_ADMIN_NAME=System Administrator
SUPER_ADMIN_EMAIL=superadmin@example.com
SUPER_ADMIN_PASSWORD=12345678910

# Mail (optional — account invite emails via Resend)
# RESEND_API_KEY=
# MAIL_FROM=DoodleBlue <onboarding@resend.dev>

# Data Loan — hourly due-date/settlement sweep (enabled by default; set false to disable)
LOAN_JOBS_ENABLED=false

# Demo-only: expose POST /admin/jobs/loan-nightly?asOf=... for super admins
# Never enable in production.
ALLOW_DEMO_JOBS=true

# Zylo Data Transfer — P2P sharing of banked data (values shown are the defaults)
# DATA_TRANSFER_MIN_MB=10            # smallest transfer allowed
# DATA_TRANSFER_MAX_MB=2048          # per-transfer cap when the plan sets none
# DATA_TRANSFER_DAILY_LIMIT_MB=5120  # total a SIM may send per day (IST)

# Zylo WiFi — broadband lifecycle knobs (values shown are the defaults)
# WIFI_GRACE_DAYS=3                 # days after plan expiry before suspension
# WIFI_MAX_PAUSE_DAYS_PER_YEAR=30   # yearly pause allowance per connection
# WIFI_RENTAL_RETURN_DAYS=7         # days to return a rented router after disconnect
# WIFI_SIM_BUNDLE_DISCOUNT_PERCENT=0  # % off plan prices when linked to the customer's active SIM
# WIFI_JOBS_ENABLED=false           # set false to disable the hourly lifecycle job
