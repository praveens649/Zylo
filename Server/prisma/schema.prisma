generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ======================================================
// ENUMS
// ======================================================

enum UserRole {
  SUPER_ADMIN
  CUSTOMER
}

enum SimCategory {
  PERSONAL
  BUSINESS
}

enum SimTechnology {
  PHYSICAL
  ESIM
}

enum SimStatus {
  PENDING_ACTIVATION
  ACTIVE
  GRACE_PERIOD
  DEACTIVATED
  SUSPENDED
  LOST
  CANCELLED
}

enum PhoneNumberStatus {
  AVAILABLE
  RESERVED
  ASSIGNED
}

enum PhoneNumberType {
  STANDARD
  PREMIUM
}

enum PlanType {
  PREPAID
  POSTPAID
  BUSINESS
  VALIDITY_ONLY
}

enum PlanSubscriptionStatus {
  PENDING
  ACTIVE
  EXPIRED
  CANCELLED
}

enum OrderType {
  SIM_PURCHASE
  PLAN_PURCHASE
  RECHARGE
  SET_TOP_BOX_ORDER
  TV_PACK_PURCHASE
  WIFI_ORDER
  WIFI_PLAN_PURCHASE
  MUSIC_SUBSCRIPTION
}

enum OrderStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
  CANCELLED
}

enum PaymentType {
  ONE_TIME
  SUBSCRIPTION
}

enum SubscriptionStatus {
  ACTIVE
  TRIALING
  PAST_DUE
  INCOMPLETE
  CANCELLED
  EXPIRED
  UNPAID
}

enum OrganizationStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum OrganizationMemberRole {
  OWNER
  ADMIN
  EMPLOYEE
}

enum MembershipStatus {
  PENDING
  ACTIVE
  REJECTED
  SUSPENDED
  REMOVED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
}

enum SupportCategory {
  SIM_ACTIVATION
  RECHARGE
  PLAN
  PAYMENT
  SIM_REPLACEMENT
  BUSINESS_SIM
  SET_TOP_BOX
  WIFI
  OTHER
}

enum DataBankTransactionType {
  DEPOSIT
  REDEMPTION
  EXPIRY
  ADJUSTMENT
  TRANSFER_OUT
  TRANSFER_IN
}

enum DataTransferStatus {
  PENDING
  COMPLETED
  FAILED
  CANCELLED
}

enum DataTransferRequestStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
  CANCELLED
}

enum UsageSimulationStatus {
  RUNNING
  STOPPED
  COMPLETED
}

enum DataLoanStatus {
  ACTIVE
  PARTIALLY_REPAID
  DUE
  REPAID
  SETTLED
  CANCELLED
}

enum DataLoanTransactionType {
  LOAN_ISSUED
  BANK_REPAYMENT
  RECHARGE_REPAYMENT
  ADJUSTMENT
}

enum QuestMetric {
  DATA_BANK_SAVED_MB
  DATA_TRANSFERRED_MB
  DATA_BANK_REDEEMED_MB
  DAILY_CHECK_IN
  QUESTS_COMPLETED
  PLAN_RECHARGED
  STREAK_DAYS
}

enum QuestFrequency {
  DAILY
  WEEKLY
  ONE_TIME
}

enum QuestStatus {
  IN_PROGRESS
  COMPLETED
  CLAIMED
  EXPIRED
}

enum QuestRewardType {
  DATA_BANK_MB
  RECHARGE_DISCOUNT
  XP_ONLY
}

enum XpSource {
  QUEST
  ACHIEVEMENT
  STREAK
  BONUS
  ADMIN
}

enum RewardType {
  DATA_MB
  BADGE
  TITLE
  COUPON
}

enum RewardRedemptionStatus {
  PENDING
  SUCCESS
  FAILED
}

enum TravelEsimOrderStatus {
  PENDING_PAYMENT
  PAID
  PROCESSING
  READY_TO_ACTIVATE
  ACTIVATED
  COMPLETED
  CANCELLED
  FAILED
  REFUNDED
}

enum KycStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum KycDocumentType {
  AADHAAR
  PAN
  PASSPORT
  DRIVING_LICENSE
  VOTER_ID
}

// ======================================================
// USERS
// ======================================================

model User {
  id                 String   @id @default(uuid())
  name               String
  email              String   @unique
  passwordHash       String
  role               UserRole @default(CUSTOMER)
  image              String?
  mustChangePassword Boolean  @default(false)
  isActive           Boolean  @default(true)

  sims                 Sim[]
  orders               Order[]
  payments             Payment[]
  stripeSubscriptions  StripeSubscription[]
  supportTickets       SupportTicket[]
  notifications        Notification[]
  dataLoans            DataLoan[]
  userQuests           UserQuest[]
  gameProfile          UserGameProfile?
  userAchievements     UserAchievement[]
  xpLedgerEntries      XpLedger[]
  rewardRedemptions    RewardRedemption[]
  travelEsimOrders     TravelEsimOrder[]
  setTopBoxConnections SetTopBoxConnection[]
  wifiConnections      WifiConnection[]
  musicSubscriptions   MusicSubscription[]
  kyc                  KycVerification?

  ownedOrganizations      BusinessOrganization[] @relation("OrganizationOwner")
  organizationMemberships OrganizationMember[]
  reservedPhoneNumbers    PhoneNumber[]          @relation("NumberReserver")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([role])
  @@index([isActive])
  @@index([createdAt])
}

// ======================================================
// BUSINESS ORGANIZATIONS
// An owner registers a business and requests a 4-digit prefix.
// ======================================================

model BusinessOrganization {
  id                 String  @id @default(uuid())
  name               String
  businessType       String?
  registrationNumber String? @unique
  businessEmail      String
  address            String
  city               String
  state              String
  postalCode         String?

  // Store prefixes as strings to preserve leading zeroes.
  // Example: "0482"
  numberPrefix String? @unique

  status          OrganizationStatus @default(PENDING)
  rejectionReason String?
  verifiedAt      DateTime?

  // Uploaded GST/business certificate used during verification.
  verificationDocumentId String?
  verificationDocument   StoredFile? @relation(fields: [verificationDocumentId], references: [id], onDelete: SetNull)

  ownerUserId String
  owner       User   @relation("OrganizationOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)

  members      OrganizationMember[]
  invitations  BusinessInvite[]
  phoneNumbers PhoneNumber[]
  sims         Sim[]
  orders       Order[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerUserId])
  @@index([status])
}

// ======================================================
// ORGANIZATION MEMBERS
// Employees join an existing approved organization.
// ======================================================

model OrganizationMember {
  id             String @id @default(uuid())
  organizationId String
  userId         String

  // Employee ID inside the organization, not a Zylo user ID.
  employeeId String
  role       OrganizationMemberRole @default(EMPLOYEE)
  status     MembershipStatus       @default(PENDING)
  verifiedAt DateTime?

  organization BusinessOrganization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  sims Sim[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // One employee ID per organization.
  @@unique([organizationId, employeeId])
  // One account has one membership per organization.
  @@unique([organizationId, userId])
  @@index([userId, status])
  @@index([organizationId, status])
}

// ======================================================
// BUSINESS INVITATIONS
// Invite employees without asking them to register
// the organization's business details again.
// ======================================================

model BusinessInvite {
  id             String           @id @default(uuid())
  organizationId String
  email          String
  employeeId     String?
  phoneNumberId  String?
  tokenHash      String           @unique
  status         InvitationStatus @default(PENDING)
  expiresAt      DateTime
  acceptedAt     DateTime?

  organization BusinessOrganization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  phoneNumber  PhoneNumber?         @relation(fields: [phoneNumberId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, status])
  @@index([email, status])
}

// ======================================================
// PHONE NUMBER INVENTORY
// Personal numbers can be standard or premium.
// Business numbers belong to an approved organization.
// ======================================================

model PhoneNumber {
  id            String            @id @default(uuid())
  number        String            @unique
  prefix        String?
  type          PhoneNumberType   @default(STANDARD)
  price         Decimal           @default(0) @db.Decimal(10, 2)
  status        PhoneNumberStatus @default(AVAILABLE)
  reservedUntil DateTime?

  // Which customer currently holds this number during checkout.
  reservedByUserId String?

  // ISO country code the number belongs to (IN, SG, AE, ...) — travel
  // eSIMs get a number from their destination country.
  countryCode String @default("IN")

  organizationId String?
  organization   BusinessOrganization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  reservedBy User? @relation("NumberReserver", fields: [reservedByUserId], references: [id], onDelete: SetNull)

  sim    Sim?
  orders Order[]

  businessInvites BusinessInvite[]

  travelEsimOrders TravelEsimOrder[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, type])
  @@index([organizationId, status])
  @@index([prefix, status])
}

// ======================================================
// SIM MANAGEMENT
// SIM category and SIM technology are separate concepts.
// PERSONAL/BUSINESS describes ownership.
// PHYSICAL/ESIM describes the SIM format.
// ======================================================

model Sim {
  id            String @id @default(uuid())
  userId        String
  phoneNumberId String @unique

  category    SimCategory   @default(PERSONAL)
  technology  SimTechnology @default(PHYSICAL)
  status      SimStatus     @default(PENDING_ACTIVATION)
  activatedAt DateTime?

  // Lifecycle tracking
  planExpiredAt     DateTime?
  gracePeriodEndsAt DateTime?
  deactivatedAt     DateTime?

  organizationId       String?
  organizationMemberId String?

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  phoneNumber PhoneNumber @relation(fields: [phoneNumberId], references: [id], onDelete: Restrict)

  organization BusinessOrganization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  organizationMember OrganizationMember? @relation(fields: [organizationMemberId], references: [id], onDelete: Restrict)

  planSubscriptions PlanSubscription[]
  orders            Order[]
  supportTickets    SupportTicket[]

  dataBankAccount   DataBankAccount?
  sentTransfers     DataTransfer[]   @relation("TransferSenderSim")
  receivedTransfers DataTransfer[]   @relation("TransferRecipientSim")

  sentDataRequests     DataTransferRequest[] @relation("DataRequestSenderSim")
  receivedDataRequests DataTransferRequest[] @relation("DataRequestRecipientSim")

  dataLoans DataLoan[]

  dailyUsages      DailyDataUsage[]
  usageSimulations UsageSimulation[]

  setTopBoxConnections SetTopBoxConnection[]
  wifiConnections      WifiConnection[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, status])
  @@index([organizationId, category])
  @@index([organizationMemberId])
}

// ======================================================
// MOBILE PLANS
// businessOnly = true means the plan is restricted
// to eligible business SIMs.
// ======================================================

model Plan {
  id              String   @id @default(uuid())
  name            String   @unique
  description     String?
  type            PlanType @default(PREPAID)
  price           Decimal  @db.Decimal(10, 2)
  currency        String   @default("inr")
  validityDays    Int      @default(28)
  dataAllowanceGb Decimal? @db.Decimal(8, 2)
  callingBenefit  String   @default("Unlimited")
  smsCount        Int?
  businessOnly    Boolean  @default(false)
  isActive        Boolean  @default(true)
  isFeatured      Boolean  @default(false)

  // A validity-only pack gives no regular plan benefits.
  isValidityOnly Boolean @default(false)

  // Daily data simulation allowance (set explicitly per plan; null = simulation disabled)
  dailyDataAllowanceMb Int?

  // Zylo Data Bank settings
  dataBankEnabled    Boolean @default(false)
  rolloverLimitMb    Int?
  rolloverExpiryDays Int?

  // Zylo Data Transfer settings
  dataTransferEnabled Boolean @default(false)
  transferLimitMb     Int?

  orders            Order[]
  planSubscriptions PlanSubscription[]
  dailyUsages       DailyDataUsage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type, isActive])
  @@index([businessOnly, isActive])
  @@index([price])
}

// ======================================================
// PLAN HISTORY PER SIM
// A user can own multiple SIMs with separate plans.
// ======================================================

model PlanSubscription {
  id        String                 @id @default(uuid())
  simId     String
  planId    String
  orderId   String?                @unique
  status    PlanSubscriptionStatus @default(PENDING)
  startDate DateTime?
  endDate   DateTime?
  autoRenew Boolean                @default(false)

  sim Sim @relation(fields: [simId], references: [id], onDelete: Restrict)

  plan Plan @relation(fields: [planId], references: [id], onDelete: Restrict)

  order Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([simId, status])
  @@index([status, endDate])
}

// ======================================================
// ORDERS
// Supports personal and business SIM purchases.
// ======================================================

model Order {
  id       String      @id @default(uuid())
  userId   String
  type     OrderType
  status   OrderStatus @default(PENDING)
  amount   Decimal     @db.Decimal(10, 2)
  currency String      @default("inr")

  simId          String?
  phoneNumberId  String?
  planId         String?
  organizationId String?

  // Gift recharge — set when the payer recharges someone else's number.
  rechargedForUserId String?

  setTopBoxModelId      String?
  tvPlanId              String?
  setTopBoxConnectionId String?

  wifiDeviceId     String?
  wifiPlanId       String?
  wifiConnectionId String?

  musicPlanId String?

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  sim Sim? @relation(fields: [simId], references: [id], onDelete: Restrict)

  phoneNumber PhoneNumber? @relation(fields: [phoneNumberId], references: [id], onDelete: Restrict)

  plan Plan? @relation(fields: [planId], references: [id], onDelete: Restrict)

  organization BusinessOrganization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  setTopBoxModel      SetTopBoxModel?      @relation(fields: [setTopBoxModelId], references: [id], onDelete: Restrict)
  tvPlan              TvPlan?              @relation(fields: [tvPlanId], references: [id], onDelete: Restrict)
  setTopBoxConnection SetTopBoxConnection? @relation(fields: [setTopBoxConnectionId], references: [id], onDelete: Restrict)

  wifiDevice     WifiDevice?     @relation(fields: [wifiDeviceId], references: [id], onDelete: Restrict)
  wifiPlan       WifiPlan?       @relation(fields: [wifiPlanId], references: [id], onDelete: Restrict)
  wifiConnection WifiConnection? @relation(fields: [wifiConnectionId], references: [id], onDelete: Restrict)

  musicPlan MusicPlan? @relation(fields: [musicPlanId], references: [id], onDelete: Restrict)

  payment           Payment?
  planSubscription  PlanSubscription?
  tvSubscription    TvSubscription?
  wifiSubscription  WifiSubscription?
  musicSubscription MusicSubscription?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([type])
  @@index([organizationId])
  @@index([setTopBoxConnectionId])
  @@index([wifiConnectionId])
}

// ======================================================
// STRIPE PAYMENTS
// ======================================================

model Payment {
  id      String  @id @default(uuid())
  userId  String
  orderId String? @unique

  type        PaymentType   @default(ONE_TIME)
  status      PaymentStatus @default(PENDING)
  amount      Decimal       @db.Decimal(10, 2)
  currency    String        @default("inr")
  description String?

  stripeCheckoutSessionId String? @unique
  stripePaymentIntentId   String? @unique
  stripeInvoiceId         String? @unique

  failureCode    String?
  failureMessage String?
  paidAt         DateTime?
  refundedAt     DateTime?
  metadata       Json?

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  order Order? @relation(fields: [orderId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

// ======================================================
// STRIPE RECURRING SUBSCRIPTIONS
// Kept separate from SIM plan subscriptions.
// ======================================================

model StripeSubscription {
  id     String @id @default(uuid())
  userId String @unique

  stripeCustomerId     String?            @unique
  stripeSubscriptionId String             @unique
  stripePriceId        String?
  plan                 String?
  status               String             @default("incomplete")
  subscriptionStatus   SubscriptionStatus @default(INCOMPLETE)
  billingInterval      String?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean            @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([subscriptionStatus, currentPeriodEnd])
}

// ======================================================
// CUSTOMER SUPPORT
// ======================================================

model SupportTicket {
  id           String          @id @default(uuid())
  ticketNumber String          @unique
  userId       String
  simId        String?
  subject      String
  description  String
  category     SupportCategory @default(OTHER)
  priority     TicketPriority  @default(MEDIUM)
  status       TicketStatus    @default(OPEN)
  adminReply   String?
  resolvedAt   DateTime?

  setTopBoxConnectionId String?
  wifiConnectionId      String?

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  sim Sim? @relation(fields: [simId], references: [id], onDelete: SetNull)

  setTopBoxConnection SetTopBoxConnection? @relation(fields: [setTopBoxConnectionId], references: [id], onDelete: SetNull)
  wifiConnection      WifiConnection?      @relation(fields: [wifiConnectionId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, createdAt])
  @@index([status, priority])
}

// ======================================================
// NOTIFICATIONS
// ======================================================

model Notification {
  id      String  @id @default(uuid())
  userId  String
  title   String
  message String
  isRead  Boolean @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId, isRead, createdAt])
}

// ======================================================
// ZYLO DATA BANK
// ======================================================

model DataBankAccount {
  id        String @id @default(uuid())
  simId     String @unique
  balanceMb Int    @default(0)

  sim          Sim                   @relation(fields: [simId], references: [id], onDelete: Restrict)
  transactions DataBankTransaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([balanceMb])
}

model DataBankTransaction {
  id             String                  @id @default(uuid())
  dataBankId     String
  type           DataBankTransactionType
  amountMb       Int
  balanceAfterMb Int
  description    String?
  reference      String                  @unique @default(uuid())
  expiresAt      DateTime?
  processedAt    DateTime                @default(now())

  // Which daily usage cycle produced this deposit (audit trail for rollover saves).
  dailyUsageId String?

  dataBank   DataBankAccount @relation(fields: [dataBankId], references: [id], onDelete: Restrict)
  dailyUsage DailyDataUsage? @relation(fields: [dailyUsageId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([dataBankId, processedAt])
  @@index([type, processedAt])
  @@index([expiresAt])
  @@index([dailyUsageId])
}

// ======================================================
// ZYLO DATA TRANSFER
// ======================================================

model DataTransfer {
  id        String @id @default(uuid())
  reference String @unique @default(uuid())

  fromSimId      String
  toSimId        String
  amountMb       Int
  status         DataTransferStatus @default(PENDING)
  message        String?
  failureReason  String?
  idempotencyKey String?            @unique

  completedAt DateTime?

  fromSim Sim @relation("TransferSenderSim", fields: [fromSimId], references: [id], onDelete: Restrict)

  toSim Sim @relation("TransferRecipientSim", fields: [toSimId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([fromSimId, createdAt])
  @@index([toSimId, createdAt])
  @@index([status, createdAt])
}

// ======================================================
// ZYLO DATA TRANSFER REQUESTS
// ======================================================

model DataTransferRequest {
  id             String                    @id @default(uuid())
  reference      String                    @unique @default(uuid())
  requesterSimId String
  recipientSimId String
  amountMb       Int
  message        String?
  status         DataTransferRequestStatus @default(PENDING)
  expiresAt      DateTime
  respondedAt    DateTime?

  requesterSim Sim @relation("DataRequestSenderSim", fields: [requesterSimId], references: [id], onDelete: Restrict)

  recipientSim Sim @relation("DataRequestRecipientSim", fields: [recipientSimId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([requesterSimId, status])
  @@index([recipientSimId, status])
}

// ======================================================
// ZYLO DATA LOAN
// ======================================================

model DataLoan {
  id     String @id @default(uuid())
  userId String
  simId  String

  originalAmountMb    Int
  outstandingAmountMb Int
  status              DataLoanStatus @default(ACTIVE)

  borrowedAt DateTime  @default(now())
  dueAt      DateTime?
  repaidAt   DateTime?

  user         User                  @relation(fields: [userId], references: [id], onDelete: Restrict)
  sim          Sim                   @relation(fields: [simId], references: [id], onDelete: Restrict)
  transactions DataLoanTransaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, status])
  @@index([simId, status])
  @@index([status, dueAt])
}

model DataLoanTransaction {
  id             String                  @id @default(uuid())
  loanId         String
  type           DataLoanTransactionType
  amountMb       Int
  balanceAfterMb Int
  reference      String                  @unique @default(uuid())
  description    String?
  processedAt    DateTime                @default(now())

  loan DataLoan @relation(fields: [loanId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())

  @@index([loanId, processedAt])
  @@index([type, processedAt])
}

// ======================================================
// ZYLO DATA USAGE SIMULATION
// Tracks the daily data consumption demo per SIM.
// One DailyDataUsage record per SIM per calendar day (IST).
// UsageSimulation records each start/stop session within a day.
// ======================================================

model DailyDataUsage {
  id          String   @id @default(uuid())
  simId       String
  planId      String
  cycleDate   DateTime @db.Date
  allowanceMb Int
  usedMb      Int      @default(0)

  // How much of this cycle's unused data was saved to the Data Bank.
  bankedMb Int       @default(0)
  bankedAt DateTime?

  // Extra data redeemed from the Data Bank into today's usable pool.
  redeemedMb Int @default(0)

  sim              Sim                   @relation(fields: [simId], references: [id], onDelete: Restrict)
  plan             Plan                  @relation(fields: [planId], references: [id], onDelete: Restrict)
  simulations      UsageSimulation[]
  bankTransactions DataBankTransaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([simId, cycleDate])
  @@index([cycleDate])
  @@index([planId])
}

model UsageSimulation {
  id           String                @id @default(uuid())
  simId        String
  dailyUsageId String
  status       UsageSimulationStatus @default(RUNNING)

  startUsedMb Int @default(0)
  consumedMb  Int @default(0)

  startedAt DateTime  @default(now())
  stoppedAt DateTime?

  sim        Sim            @relation(fields: [simId], references: [id], onDelete: Restrict)
  dailyUsage DailyDataUsage @relation(fields: [dailyUsageId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([simId, status])
  @@index([dailyUsageId])
}

// ======================================================
// ZYLO DATA QUEST & GAMIFICATION
// ======================================================

model UserGameProfile {
  id             String    @id @default(uuid())
  userId         String    @unique
  level          Int       @default(1)
  totalXp        Int       @default(0)
  currentXp      Int       @default(0)
  streakDays     Int       @default(0)
  lastActiveDate DateTime? @db.Date
  unlockedBadges String[]  @default([])

  // Pack-Scoped Spendable XP (starts at 0 on recharge, resets to 0 on plan expiry)
  activePlanSubId String?
  spendablePackXp Int       @default(0)
  packTotalEarned Int       @default(0)
  packTotalWeeks  Int       @default(4)
  packStartDate   DateTime?
  packExpiryDate  DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([level])
  @@index([totalXp])
}

model Quest {
  id          String         @id @default(uuid())
  title       String
  description String
  metric      QuestMetric
  frequency   QuestFrequency @default(DAILY)
  targetValue Int
  xpReward    Int            @default(100)
  weekNumber  Int?

  rewardType          QuestRewardType @default(XP_ONLY)
  rewardAmountMb      Int?
  rewardDiscountPaise Int?

  startsAt DateTime?
  endsAt   DateTime?
  isActive Boolean   @default(true)

  userQuests UserQuest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, frequency])
}

model UserQuest {
  id         String  @id @default(uuid())
  userId     String
  questId    String
  planSubId  String?
  weekNumber Int     @default(1)

  periodStart DateTime
  periodEnd   DateTime
  progress    Int         @default(0)
  status      QuestStatus @default(IN_PROGRESS)

  completedAt DateTime?
  claimedAt   DateTime?

  user  User  @relation(fields: [userId], references: [id], onDelete: Restrict)
  quest Quest @relation(fields: [questId], references: [id], onDelete: Restrict)

  coupon RewardCoupon?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, questId, periodStart])
  @@index([userId, status])
  @@index([periodEnd, status])
  @@index([userId, planSubId, weekNumber])
}

model RewardCoupon {
  id          String @id @default(uuid())
  userId      String
  userQuestId String @unique
  code        String @unique

  discountPaise        Int
  minimumRechargePaise Int @default(0)

  expiresAt  DateTime
  redeemedAt DateTime?

  userQuest UserQuest @relation(fields: [userQuestId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())

  @@index([userId, expiresAt])
}

model Achievement {
  id             String  @id @default(uuid())
  name           String  @unique
  description    String
  iconUrl        String?
  badgeTier      String  @default("BRONZE")
  conditionType  String
  conditionValue Int
  xpReward       Int     @default(50)
  isHidden       Boolean @default(false)
  isActive       Boolean @default(true)

  userAchievements UserAchievement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([conditionType, conditionValue])
  @@index([isActive])
}

model UserAchievement {
  id            String   @id @default(uuid())
  userId        String
  achievementId String
  unlockedAt    DateTime @default(now())

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, achievementId])
  @@index([userId, unlockedAt])
}

model XpLedger {
  id          String   @id @default(uuid())
  userId      String
  source      XpSource
  sourceId    String?
  xpAmount    Int
  description String
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([source, sourceId])
}

model RewardCatalog {
  id            String     @id @default(uuid())
  name          String     @unique
  description   String?
  type          RewardType
  valueMb       Int?
  discountPaise Int?
  badgeCode     String?
  requiredXp    Int        @default(0)
  requiredLevel Int        @default(1)
  isActive      Boolean    @default(true)

  redemptions RewardRedemption[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, requiredLevel])
}

model RewardRedemption {
  id            String                 @id @default(uuid())
  userId        String
  rewardId      String
  status        RewardRedemptionStatus @default(PENDING)
  reference     String                 @unique @default(uuid())
  couponCode    String?
  discountPaise Int?
  valueMb       Int?
  badgeCode     String?
  expiresAt     DateTime?
  isUsed        Boolean                @default(false)
  usedAt        DateTime?
  redeemedAt    DateTime               @default(now())

  user   User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  reward RewardCatalog @relation(fields: [rewardId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, status])
}

// ======================================================
// TRAVEL eSIM
// ======================================================

model InternationalPlan {
  id          String  @id @default(uuid())
  name        String
  description String?

  // ISO country code, e.g. SG, AE, GB, US, JP
  destinationCountry String

  dataAllowanceMb Int
  validityDays    Int

  // Optional voice/SMS bundle — null means the pack is data-only.
  callMinutes Int?
  smsCount    Int?

  pricePaise Int
  currency   String @default("INR")

  // Optional real eSIM provider integration details
  providerName     String?
  providerPlanCode String?

  isActive Boolean @default(true)

  orders TravelEsimOrder[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([destinationCountry, isActive])
}

model TravelEsimOrder {
  id        String @id @default(uuid())
  reference String @unique @default(uuid())

  userId              String
  internationalPlanId String

  // Travel details
  destinationCountry String
  departureDate      DateTime
  returnDate         DateTime

  // Passport details
  travellerName           String
  passportCountry         String
  passportNumberEncrypted String
  passportExpiryDate      DateTime

  // Order and payment
  status      TravelEsimOrderStatus @default(PENDING_PAYMENT)
  amountPaise Int
  currency    String                @default("INR")

  stripeCheckoutSessionId String? @unique
  stripePaymentIntentId   String? @unique

  // eSIM activation details (encrypted where sensitive)
  activationCodeEncrypted String?
  qrCodeDataEncrypted     String?
  activationExpiresAt     DateTime?
  activatedAt             DateTime?

  // Provider fulfilment
  providerOrderId String? @unique
  failureReason   String?

  // Optional local number for the destination (held 10 min, assigned on payment)
  phoneNumberId String?
  phoneNumber   PhoneNumber? @relation(fields: [phoneNumberId], references: [id], onDelete: SetNull)

  user              User              @relation(fields: [userId], references: [id], onDelete: Restrict)
  internationalPlan InternationalPlan @relation(fields: [internationalPlanId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([destinationCountry, departureDate])
}

// ======================================================
// KYC VERIFICATION
// Customers submit identity details before buying a SIM.
// ======================================================

model KycVerification {
  id     String @id @default(uuid())
  userId String @unique

  fullName    String
  dateOfBirth DateTime?

  address    String
  city       String
  state      String
  postalCode String

  documentType            KycDocumentType
  documentNumberEncrypted String

  status          KycStatus @default(PENDING)
  rejectionReason String?
  submittedAt     DateTime  @default(now())
  verifiedAt      DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, submittedAt])
}

// ======================================================
// OBJECT STORAGE
// ======================================================

model StoredFile {
  id       String @id @default(uuid())
  filename String
  mimeType String
  size     Int
  data     Bytes

  businessOrganizations BusinessOrganization[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ======================================================
// ZYLO SET-TOP BOX
// ======================================================

enum SetTopBoxResolution {
  HD
  UHD_4K
}

enum SetTopBoxUnitStatus {
  IN_STOCK
  RESERVED
  ASSIGNED
  INSTALLED
  FAULTY
  RETURNED
  RETIRED
}

enum BoxOwnership {
  PURCHASE
  RENTAL
}

enum TvConnectionStatus {
  PENDING_INSTALLATION
  ACTIVE
  PAUSED
  GRACE_PERIOD
  SUSPENDED
  DISCONNECTED
  CANCELLED
}

enum TvPlanType {
  BASE
  ADD_ON
}

enum TvSubscriptionStatus {
  PENDING
  ACTIVE
  PAUSED
  EXPIRED
  CANCELLED
}

enum InstallationType {
  TECHNICIAN
  SELF_INSTALL
}

enum InstallationSlot {
  MORNING
  AFTERNOON
  EVENING
}

enum InstallationStatus {
  REQUESTED
  SCHEDULED
  RESCHEDULED
  COMPLETED
  FAILED
  CANCELLED
}

model SetTopBoxModel {
  id           String              @id @default(uuid())
  name         String              @unique
  sku          String              @unique
  description  String?
  resolution   SetTopBoxResolution @default(HD)
  isSmart      Boolean             @default(false)
  hasRecording Boolean             @default(false)
  storageGb    Int?
  imageFileId  String?

  // A null price means that option is not offered.
  purchasePrice   Decimal? @db.Decimal(10, 2)
  rentalPerMonth  Decimal? @db.Decimal(10, 2)
  securityDeposit Decimal? @db.Decimal(10, 2)

  isActive   Boolean @default(true)
  isFeatured Boolean @default(false)

  units       SetTopBoxUnit[]
  connections SetTopBoxConnection[]
  orders      Order[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, resolution])
}

model SetTopBoxUnit {
  id              String              @id @default(uuid())
  modelId         String
  serialNumber    String              @unique
  macAddress      String              @unique
  smartCardNumber String              @unique
  status          SetTopBoxUnitStatus @default(IN_STOCK)
  warrantyEndsAt  DateTime?
  notes           String?

  model      SetTopBoxModel       @relation(fields: [modelId], references: [id], onDelete: Restrict)
  connection SetTopBoxConnection?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([modelId, status])
}

model SetTopBoxConnection {
  id               String @id @default(uuid())
  connectionNumber String @unique
  userId           String
  modelId          String

  simId  String?
  unitId String? @unique

  ownership BoxOwnership       @default(PURCHASE)
  status    TvConnectionStatus @default(PENDING_INSTALLATION)

  addressLine  String
  city         String
  state        String
  postalCode   String
  contactPhone String

  activatedAt       DateTime?
  planExpiredAt     DateTime?
  gracePeriodEndsAt DateTime?
  pausedAt          DateTime?
  pauseEndsAt       DateTime?

  // Pause allowance tracking: days used inside the rolling 365-day window.
  pauseDaysUsed        Int       @default(0)
  pauseWindowStartedAt DateTime?
  disconnectedAt       DateTime?
  returnDueAt          DateTime?

  user  User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  model SetTopBoxModel @relation(fields: [modelId], references: [id], onDelete: Restrict)
  sim   Sim?           @relation(fields: [simId], references: [id], onDelete: SetNull)
  unit  SetTopBoxUnit? @relation(fields: [unitId], references: [id], onDelete: Restrict)

  subscriptions  TvSubscription[]
  installations  InstallationRequest[]
  orders         Order[]
  supportTickets SupportTicket[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, status])
  @@index([status, planExpiredAt])
  @@index([simId])
}

model TvPlan {
  id             String     @id @default(uuid())
  name           String     @unique
  description    String?
  type           TvPlanType @default(BASE)
  price          Decimal    @db.Decimal(10, 2)
  currency       String     @default("inr")
  validityDays   Int        @default(30)
  channelCount   Int
  hdChannelCount Int        @default(0)
  languages      String[]
  requires4kBox  Boolean    @default(false)
  isActive       Boolean    @default(true)
  isFeatured     Boolean    @default(false)

  subscriptions TvSubscription[]
  orders        Order[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type, isActive])
  @@index([price])
}

model TvSubscription {
  id           String               @id @default(uuid())
  connectionId String
  tvPlanId     String
  orderId      String?              @unique
  status       TvSubscriptionStatus @default(PENDING)
  startDate    DateTime?
  endDate      DateTime?
  autoRenew    Boolean              @default(false)

  connection SetTopBoxConnection @relation(fields: [connectionId], references: [id], onDelete: Restrict)
  tvPlan     TvPlan              @relation(fields: [tvPlanId], references: [id], onDelete: Restrict)
  order      Order?              @relation(fields: [orderId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([connectionId, status])
  @@index([status, endDate])
}

model InstallationRequest {
  id           String             @id @default(uuid())
  reference    String             @unique @default(uuid())
  connectionId String
  type         InstallationType   @default(TECHNICIAN)
  status       InstallationStatus @default(REQUESTED)

  preferredDate DateTime
  preferredSlot InstallationSlot @default(MORNING)
  scheduledAt   DateTime?
  customerNotes String?

  technicianName  String?
  technicianPhone String?
  completedAt     DateTime?
  failureReason   String?

  connection SetTopBoxConnection @relation(fields: [connectionId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([connectionId, status])
  @@index([status, scheduledAt])
}

// ======================================================
// ZYLO WIFI (HOME BROADBAND)
// Fibre broadband: router/ONT hardware, broadband plans,
// technician installation and rental returns.
// ======================================================

enum WifiBand {
  SINGLE_BAND
  DUAL_BAND
  TRI_BAND
}

enum WifiUnitStatus {
  IN_STOCK
  RESERVED
  ASSIGNED
  INSTALLED
  FAULTY
  RETURNED
  RETIRED
}

enum DeviceOwnership {
  PURCHASE
  RENTAL
}

enum WifiConnectionStatus {
  PENDING_INSTALLATION
  ACTIVE
  PAUSED
  GRACE_PERIOD
  SUSPENDED
  DISCONNECTED
  CANCELLED
}

enum WifiPlanType {
  BASE
  ADD_ON
}

enum WifiSubscriptionStatus {
  PENDING
  ACTIVE
  PAUSED
  EXPIRED
  CANCELLED
}

model WifiDevice {
  id            String   @id @default(uuid())
  name          String   @unique
  sku           String   @unique
  description   String?
  band          WifiBand @default(DUAL_BAND)
  wifiStandard  String   @default("Wi-Fi 5")
  maxDevices    Int      @default(32)
  ethernetPorts Int      @default(4)
  isMesh        Boolean  @default(false)
  imageFileId   String?

  // A null price means that option is not offered.
  purchasePrice   Decimal? @db.Decimal(10, 2)
  rentalPerMonth  Decimal? @db.Decimal(10, 2)
  securityDeposit Decimal? @db.Decimal(10, 2)

  isActive   Boolean @default(true)
  isFeatured Boolean @default(false)

  units       WifiDeviceUnit[]
  connections WifiConnection[]
  orders      Order[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, band])
}

model WifiDeviceUnit {
  id             String         @id @default(uuid())
  deviceId       String
  serialNumber   String         @unique
  macAddress     String         @unique
  status         WifiUnitStatus @default(IN_STOCK)
  warrantyEndsAt DateTime?
  notes          String?

  device     WifiDevice      @relation(fields: [deviceId], references: [id], onDelete: Restrict)
  connection WifiConnection?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([deviceId, status])
}

model WifiConnection {
  id               String @id @default(uuid())
  connectionNumber String @unique
  userId           String
  deviceId         String

  simId  String?
  unitId String? @unique

  ownership DeviceOwnership      @default(PURCHASE)
  status    WifiConnectionStatus @default(PENDING_INSTALLATION)

  addressLine  String
  city         String
  state        String
  postalCode   String
  contactPhone String

  activatedAt       DateTime?
  planExpiredAt     DateTime?
  gracePeriodEndsAt DateTime?
  pausedAt          DateTime?
  pauseEndsAt       DateTime?

  // Pause allowance tracking: days used inside the rolling 365-day window.
  pauseDaysUsed        Int       @default(0)
  pauseWindowStartedAt DateTime?
  disconnectedAt       DateTime?
  returnDueAt          DateTime?

  user   User            @relation(fields: [userId], references: [id], onDelete: Restrict)
  device WifiDevice      @relation(fields: [deviceId], references: [id], onDelete: Restrict)
  sim    Sim?            @relation(fields: [simId], references: [id], onDelete: SetNull)
  unit   WifiDeviceUnit? @relation(fields: [unitId], references: [id], onDelete: Restrict)

  subscriptions  WifiSubscription[]
  installations  WifiInstallation[]
  orders         Order[]
  supportTickets SupportTicket[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, status])
  @@index([status, planExpiredAt])
  @@index([simId])
}

model WifiPlan {
  id               String       @id @default(uuid())
  name             String       @unique
  description      String?
  type             WifiPlanType @default(BASE)
  price            Decimal      @db.Decimal(10, 2)
  currency         String       @default("inr")
  validityDays     Int          @default(30)
  speedMbps        Int
  // Null means truly unlimited data.
  dataLimitGb      Int?
  postFupSpeedMbps Int?
  requiresTriBand  Boolean      @default(false)
  features         String[]
  isActive         Boolean      @default(true)
  isFeatured       Boolean      @default(false)

  subscriptions WifiSubscription[]
  orders        Order[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type, isActive])
  @@index([price])
}

model WifiSubscription {
  id           String                 @id @default(uuid())
  connectionId String
  wifiPlanId   String
  orderId      String?                @unique
  status       WifiSubscriptionStatus @default(PENDING)
  startDate    DateTime?
  endDate      DateTime?
  autoRenew    Boolean                @default(false)

  connection WifiConnection @relation(fields: [connectionId], references: [id], onDelete: Restrict)
  wifiPlan   WifiPlan       @relation(fields: [wifiPlanId], references: [id], onDelete: Restrict)
  order      Order?         @relation(fields: [orderId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([connectionId, status])
  @@index([status, endDate])
}

model WifiInstallation {
  id           String             @id @default(uuid())
  reference    String             @unique @default(uuid())
  connectionId String
  type         InstallationType   @default(TECHNICIAN)
  status       InstallationStatus @default(REQUESTED)

  preferredDate DateTime
  preferredSlot InstallationSlot @default(MORNING)
  scheduledAt   DateTime?
  customerNotes String?

  technicianName  String?
  technicianPhone String?
  completedAt     DateTime?
  failureReason   String?

  connection WifiConnection @relation(fields: [connectionId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([connectionId, status])
  @@index([status, scheduledAt])
}

// ======================================================
// ZYLO MUSIC — streaming subscription
// A customer pays for a MusicPlan via Stripe; an ACTIVE subscription
// unlocks search + preview streaming in the app.
// ======================================================

model MusicPlan {
  id           String  @id @default(uuid())
  name         String  @unique
  description  String?
  price        Decimal @db.Decimal(10, 2)
  currency     String  @default("inr")
  validityDays Int     @default(30)

  // Demo plan tiers shown in the UI — no actual audio-quality difference.
  audioQuality String @default("standard")
  maxDevices   Int    @default(1)

  isActive  Boolean @default(true)
  sortOrder Int     @default(0)

  subscriptions MusicSubscription[]
  orders        Order[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MusicSubscription {
  id      String                 @id @default(uuid())
  userId  String
  orderId String                 @unique
  planId  String
  status  PlanSubscriptionStatus @default(PENDING)

  startDate DateTime
  endDate   DateTime

  user  User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  order Order     @relation(fields: [orderId], references: [id], onDelete: Restrict)
  plan  MusicPlan @relation(fields: [planId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, status])
  @@index([planId])
}
